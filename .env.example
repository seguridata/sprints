# Copia este archivo como .env.
#
# ACCESO CON CUENTAS
# SESSION_SECRET: firma las sesiones. Obligatoria en Vercel (en local se genera sola en data/).
#   Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# INICIO DE SESIÓN CON GOOGLE (recomendado): solo entran cuentas del dominio de la empresa.
#   Crea un "ID de cliente de OAuth" tipo Aplicación web en Google Cloud Console y registra como
#   URI de redireccionamiento autorizado: https://TU-DOMINIO/api/auth (y http://localhost:3210/api/auth para local).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dominio permitido (por defecto seguridata.com)
ALLOWED_DOMAIN=seguridata.com
# Correos que siempre serán administradores, separados por comas
ADMIN_EMAILS=
# Opcional: URL pública fija de la app (si no, se toma del dominio con que se entra)
# APP_URL=https://sprints.vercel.app
#
# Sin GOOGLE_CLIENT_ID, el acceso es con correo y contraseña locales:
# SETUP_CODE: código para crear la primera cuenta de administrador. Si no existe se usa APP_PASSWORD.
#   En Vercel es obligatorio uno de los dos; en local, si no hay, no se pide código.
SETUP_CODE=
# Estas llaves son las "del servidor": las usa cualquiera que
# entre a la app sin escribir su propia llave en "Ajustes del agente", y se cobran a la cuenta dueña.
# Puedes dejar una, las dos o ninguna (si ninguna, cada usuario debe poner la suya).

# Claude — https://platform.claude.com (Settings → API keys)
ANTHROPIC_API_KEY=
# Solo si tu llave de Claude empieza con sk-ant-usr- (llave de usuario, sin workspace):
# ID del workspace a usar (Console → Settings → Workspaces), p. ej. wrkspc_...
ANTHROPIC_WORKSPACE_ID=
# ChatGPT — https://platform.openai.com (API keys)
OPENAI_API_KEY=

# Opcional: modelos predeterminados y puerto
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5.4
# PORT=3210
